{
  parserClass="kr.jaehoyi.gdshader.parser.GdsParser"
  parserUtilClass="kr.jaehoyi.gdshader.parser.GdsParserUtil"

  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix="Gds"
  psiImplClassSuffix="Impl"
  psiPackage="kr.jaehoyi.gdshader.psi"
  psiImplPackage="kr.jaehoyi.gdshader.psi.impl"

  elementTypeHolderClass="kr.jaehoyi.gdshader.psi.GdsTypes"
  elementTypeClass="kr.jaehoyi.gdshader.psi.GdsElementType"
  tokenTypeClass="kr.jaehoyi.gdshader.psi.GdsTokenType"
  
  psiImplUtilClass="kr.jaehoyi.gdshader.psi.impl.GdsPsiImplUtil"
  
  tokens=[
  	UNTERMINATED_STRING_CONSTANT = "Unterminated string"
  	LINE_COMMENT = "Line comment"
  	BLOCK_COMMENT_START = "Block comment start"
	BLOCK_COMMENT_END = "Block comment end"
	BLOCK_COMMENT_CONTENT = "Block comment content"
  	PP_DEFINE_LINE = "Preprocessor define line"
    PP_UNDEF_LINE = "Preprocessor undef line"
    PP_ELSE_LINE = "Preprocessor else line"
    PP_ELIF_LINE = "Preprocessor elif line"
    PP_ENDIF_LINE = "Preprocessor endif line"
    PP_IFDEF_LINE = "Preprocessor ifdef line"
    PP_IFNDEF_LINE = "Preprocessor ifndef line"
    PP_IF_LINE = "Preprocessor if line"
    PP_ERROR_LINE = "Preprocessor error line"
    PP_INCLUDE_LINE = "Preprocessor include line"
    PP_PRAGMA_LINE = "Preprocessor pragma line"
    PP_UNKNOWN_LINE = "Preprocessor unknown line"
    PP_INACTIVE_CODE = "Inactive code"
    IDENTIFIER = "identifier"
    INT_CONSTANT = "int constant"
    UINT_CONSTANT = "uint constant"
    FLOAT_CONSTANT = "float constant"
    STRING_CONSTANT = "string constant"
    TRUE = 'true'
    FALSE = 'false'
    BRACKET_OPEN = '['
    BRACKET_CLOSE = ']'
    CURLY_BRACKET_OPEN = '{'
    CURLY_BRACKET_CLOSE = '}'
    PARENTHESIS_OPEN = '('
    PARENTHESIS_CLOSE = ')'
    QUESTION = '?'
    COMMA = ','
    COLON = ':'
    SEMICOLON = ';'
    PERIOD = '.'
    OP_EQUAL = '=='
    OP_NOT_EQUAL = '!='
    OP_LESS = '<'
    OP_LESS_EQUAL = '<='
    OP_GREATER = '>'
    OP_GREATER_EQUAL = '>='
    OP_AND = '&&'
    OP_OR = '||'
    OP_NOT = '!'
    OP_ADD = '+'
    OP_SUB = '-'
    OP_MUL = '*'
    OP_DIV = '/'
    OP_MOD = '%'
    OP_SHIFT_LEFT = '<<'
    OP_SHIFT_RIGHT = '>>'
    OP_ASSIGN = '='
    OP_ASSIGN_ADD = '+='
    OP_ASSIGN_SUB = '-='
    OP_ASSIGN_MUL = '*='
    OP_ASSIGN_DIV = '/='
    OP_ASSIGN_MOD = '%='
    OP_ASSIGN_SHIFT_LEFT = '<<='
    OP_ASSIGN_SHIFT_RIGHT = '>>='
    OP_ASSIGN_BIT_AND = '&='
    OP_ASSIGN_BIT_OR = '|='
    OP_ASSIGN_BIT_XOR = '^='
    OP_BIT_AND = '&'
    OP_BIT_OR = '|'
    OP_BIT_XOR = '^'
    OP_BIT_INVERT = '~'
    OP_INCREMENT = '++'
    OP_DECREMENT = '--'
    CF_IF = 'if'
    CF_ELSE = 'else'
    CF_FOR = 'for'
    CF_WHILE = 'while'
    CF_DO = 'do'
    CF_SWITCH = 'switch'
    CF_CASE = 'case'
    CF_DEFAULT = 'default'
    CF_BREAK = 'break'
    CF_CONTINUE = 'continue'
    CF_RETURN = 'return'
    CF_DISCARD = 'discard'
    SHADER_TYPE = 'shader_type'
    RENDER_MODE = 'render_mode'
    STENCIL_MODE = 'stencil_mode'
    CONST = 'const'
    STRUCT = 'struct'
    PRECISION_LOW = 'lowp'
    PRECISION_MEDIUM = 'mediump'
    PRECISION_HIGH = 'highp'
    UNIFORM = 'uniform'
    UNIFORM_GROUP = 'group_uniforms'
    INSTANCE = 'instance'
    GLOBAL = 'global'
    VARYING = 'varying'
    ARG_IN = 'in'
    ARG_OUT = 'out'
    ARG_INOUT = 'inout'
    INTERPOLATION_FLAT = 'flat'
    INTERPOLATION_SMOOTH = 'smooth'
    TYPE_VOID = 'void'
    TYPE_BOOL = 'bool'
    TYPE_BVEC2 = 'bvec2'
    TYPE_BVEC3 = 'bvec3'
    TYPE_BVEC4 = 'bvec4'
    TYPE_INT = 'int'
    TYPE_IVEC2 = 'ivec2'
    TYPE_IVEC3 = 'ivec3'
    TYPE_IVEC4 = 'ivec4'
    TYPE_UINT = 'uint'
    TYPE_UVEC2 = 'uvec2'
    TYPE_UVEC3 = 'uvec3'
    TYPE_UVEC4 = 'uvec4'
    TYPE_FLOAT = 'float'
    TYPE_VEC2 = 'vec2'
    TYPE_VEC3 = 'vec3'
    TYPE_VEC4 = 'vec4'
    TYPE_MAT2 = 'mat2'
    TYPE_MAT3 = 'mat3'
    TYPE_MAT4 = 'mat4'
    TYPE_SAMPLER2D = 'sampler2D'
    TYPE_ISAMPLER2D = 'isampler2D'
    TYPE_USAMPLER2D = 'usampler2D'
    TYPE_SAMPLER2DARRAY = 'sampler2DArray'
    TYPE_ISAMPLER2DARRAY = 'isampler2DArray'
    TYPE_USAMPLER2DARRAY = 'usampler2DArray'
    TYPE_SAMPLER3D = 'sampler3D'
    TYPE_ISAMPLER3D = 'isampler3D'
    TYPE_USAMPLER3D = 'usampler3D'
    TYPE_SAMPLERCUBE = 'samplerCube'
    TYPE_SAMPLERCUBEARRAY = 'samplerCubeArray'
    TYPE_SAMPLEREXT = 'samplerExternalOES'
    HINT_DEFAULT_WHITE_TEXTURE = 'hint_default_white'
    HINT_DEFAULT_BLACK_TEXTURE = 'hint_default_black'
    HINT_DEFAULT_TRANSPARENT_TEXTURE = 'hint_default_transparent'
    HINT_NORMAL_TEXTURE = 'hint_normal'
    HINT_ROUGHNESS_NORMAL_TEXTURE = 'hint_roughness_normal'
    HINT_ROUGHNESS_R = 'hint_roughness_r'
    HINT_ROUGHNESS_G = 'hint_roughness_g'
    HINT_ROUGHNESS_B = 'hint_roughness_b'
    HINT_ROUGHNESS_A = 'hint_roughness_a'
    HINT_ROUGHNESS_GRAY = 'hint_roughness_gray'
    HINT_ANISOTROPY_TEXTURE = 'hint_anisotropy'
    HINT_SOURCE_COLOR = 'source_color'
    HINT_COLOR_CONVERSION_DISABLED = 'color_conversion_disabled'
    HINT_RANGE = 'hint_range'
    HINT_ENUM = 'hint_enum'
    HINT_INSTANCE_INDEX = 'instance_index'
    HINT_SCREEN_TEXTURE = 'hint_screen_texture'
    HINT_NORMAL_ROUGHNESS_TEXTURE = 'hint_normal_roughness_texture'
    HINT_DEPTH_TEXTURE = 'hint_depth_texture'
    FILTER_NEAREST = 'filter_nearest'
    FILTER_LINEAR = 'filter_linear'
    FILTER_NEAREST_MIPMAP = 'filter_nearest_mipmap'
    FILTER_LINEAR_MIPMAP = 'filter_linear_mipmap'
    FILTER_NEAREST_MIPMAP_ANISOTROPIC = 'filter_nearest_mipmap_anisotropic'
    FILTER_LINEAR_MIPMAP_ANISOTROPIC = 'filter_linear_mipmap_anisotropic'
    REPEAT_ENABLE = 'repeat_enable'
    REPEAT_DISABLE = 'repeat_disable'
  ]
}

gdShaderFile ::= item_with_recover*

// A broken top-level declaration only loses its own tokens.
private item_with_recover ::= !<<eof>> item
{
	pin=1
	recoverWhile=item_recover
}
private item_recover ::= !(SHADER_TYPE | RENDER_MODE | STENCIL_MODE | UNIFORM_GROUP | UNIFORM | GLOBAL | INSTANCE
						 | CONST | VARYING | STRUCT | precision | type)

item ::= top_level_declaration
	   
// Top Level Declarations
top_level_declaration ::= shader_type_declaration
		    		    | render_mode_declaration
		    		    | stencil_mode_declaration
		    		    | uniform_group_declaration
		    		    | uniform_declaration
		    		    | constant_declaration
		    		    | varying_declaration
		    		    | function_declaration
		    		    | struct_declaration

// Shader Type Declaration
shader_type_declaration ::= SHADER_TYPE shader_type_name SEMICOLON
{
	pin=1
}
shader_type_name ::= IDENTIFIER

// Render Mode Declaration
render_mode_declaration ::= RENDER_MODE render_mode_declarator_list SEMICOLON
{
	pin=1
}
render_mode_declarator_list ::= render_mode_name (COMMA render_mode_name)* { pin(".*")=1 }
render_mode_name ::= IDENTIFIER

// Stencil Mode Declaration
stencil_mode_declaration ::= STENCIL_MODE stencil_mode_declarator_list SEMICOLON
{
	pin=1
}
stencil_mode_declarator_list ::= stencil_mode_name (COMMA stencil_mode_name)* { pin(".*")=1 }
stencil_mode_name ::= IDENTIFIER | INT_CONSTANT

// Uniform Group Declaration
uniform_group_declaration ::= UNIFORM_GROUP uniform_group_name? (PERIOD uniform_group_name)* SEMICOLON
{
	pin=1
}
uniform_group_name ::= IDENTIFIER

// Uniform Declaration
uniform_declaration ::= uniform_header precision? type array_size? variable_name_decl array_size? hint_section? (OP_ASSIGN expression)? SEMICOLON
{
	pin=1
}

uniform_header ::= qualified_uniform_header | UNIFORM
private qualified_uniform_header ::= uniform_qualifier UNIFORM
{
	pin=1
}
uniform_qualifier ::= GLOBAL | INSTANCE

hint_section ::= COLON hint_list
{
	pin=1
	recoverWhile=hint_section_recover
}
private hint_section_recover ::= !(SEMICOLON | OP_ASSIGN)

hint_list ::= hint (COMMA hint)* { pin(".*")=1 }

hint ::= simple_hint
	   | range_hint
	   | enum_hint
	   | instance_index_hint
	   
simple_hint ::= hint_identifier
range_hint ::= HINT_RANGE PARENTHESIS_OPEN expression COMMA expression (COMMA expression)? PARENTHESIS_CLOSE { pin(".*")=1 }
enum_hint ::= HINT_ENUM PARENTHESIS_OPEN STRING_CONSTANT (COMMA STRING_CONSTANT)* PARENTHESIS_CLOSE { pin(".*")=1 }
instance_index_hint ::= HINT_INSTANCE_INDEX PARENTHESIS_OPEN INT_CONSTANT PARENTHESIS_CLOSE

hint_identifier ::= HINT_DEFAULT_WHITE_TEXTURE
			      | HINT_DEFAULT_BLACK_TEXTURE
			      | HINT_DEFAULT_TRANSPARENT_TEXTURE
			      | HINT_NORMAL_TEXTURE
			      | HINT_ROUGHNESS_NORMAL_TEXTURE
			      | HINT_ROUGHNESS_R
			      | HINT_ROUGHNESS_G
			      | HINT_ROUGHNESS_B
			      | HINT_ROUGHNESS_A
			      | HINT_ROUGHNESS_GRAY
			      | HINT_ANISOTROPY_TEXTURE
			      | HINT_SOURCE_COLOR
			      | HINT_COLOR_CONVERSION_DISABLED	
			      | HINT_SCREEN_TEXTURE
			      | HINT_NORMAL_ROUGHNESS_TEXTURE
			      | HINT_DEPTH_TEXTURE
			      | FILTER_NEAREST
			      | FILTER_LINEAR
			      | FILTER_NEAREST_MIPMAP
			      | FILTER_LINEAR_MIPMAP
			      | FILTER_NEAREST_MIPMAP_ANISOTROPIC
			      | FILTER_LINEAR_MIPMAP_ANISOTROPIC
			      | REPEAT_ENABLE
			      | REPEAT_DISABLE

// Constant Declaration
constant_declaration ::= CONST precision? type array_size? constant_declarator_list SEMICOLON
{
	pin=1
}

constant_declarator_list ::= constant_declarator (COMMA constant_declarator)* { pin(".*")=1 }
constant_declarator ::= variable_name_decl array_size? OP_ASSIGN initializer
{
	pin=1
}

// Varying Declaration
varying_declaration ::= VARYING interpolation_qualifier? precision? type array_size? variable_name_decl array_size? SEMICOLON
{
	pin=1
}
interpolation_qualifier ::= INTERPOLATION_FLAT | INTERPOLATION_SMOOTH

// Local Variable Declaration
local_variable_declaration ::= precision? <<structTypeNameOnSameLine>> type array_size? local_variable_declarator_list SEMICOLON {
	pin=5
}

local_variable_declarator_list ::= local_variable_declarator (COMMA local_variable_declarator)* {
	pin(".*")=1
}
local_variable_declarator ::= variable_name_decl array_size? (OP_ASSIGN initializer)?

variable_name_decl ::= IDENTIFIER
{
	implements=["com.intellij.psi.PsiNameIdentifierOwner" "kr.jaehoyi.gdshader.psi.GdsVariable"]
	methods=[getName setName getNameIdentifier getVariableSpec getUseScope]
}

// A list followed by a postfix or an operator, such as `{ 1.0, 2.0 }[0]`, is parsed as an expression.
initializer ::= initializer_list &(COMMA | SEMICOLON | PARENTHESIS_CLOSE) | expression
initializer_list ::= CURLY_BRACKET_OPEN expression (COMMA expression)* CURLY_BRACKET_CLOSE { pin(".*")=1 }

array_size ::= BRACKET_OPEN expression? BRACKET_CLOSE
       
// Function Declaration
function_declaration ::= (precision? type array_size?) function_name_decl PARENTHESIS_OPEN parameter_list? PARENTHESIS_CLOSE block
{
	pin=3
}

function_name_decl ::= IDENTIFIER
{
	implements=["com.intellij.psi.PsiNameIdentifierOwner" " kr.jaehoyi.gdshader.psi.GdsFunction"]
	methods=[getName setName getNameIdentifier getFunctionSpec]
}

parameter_list ::= parameter (COMMA parameter)*
{
	pin(".*")=1
	recoverWhile=parameter_list_recover
}
private parameter_list_recover ::= !(PARENTHESIS_CLOSE)
parameter ::= parameter_qualifier? precision? type array_size? variable_name_decl array_size?
			  
parameter_qualifier ::= CONST? ARG_IN | CONST | ARG_OUT | ARG_INOUT

block ::= CURLY_BRACKET_OPEN block_body CURLY_BRACKET_CLOSE
{
	pin=1
}
block_body ::= statement_item*
{
	recoverWhile=block_body_recover
}
private block_body_recover ::= !(CURLY_BRACKET_CLOSE) 

// A broken statement only loses its own tokens.
private statement_item ::= !(CURLY_BRACKET_CLOSE | CF_CASE | CF_DEFAULT | <<eof>>) statement_body
{
	pin=1
	recoverWhile=statement_recover
}
// Must list every token a statement can start with.
private statement_recover ::= !(SEMICOLON | CURLY_BRACKET_OPEN | CURLY_BRACKET_CLOSE
							  | CF_IF | CF_FOR | CF_WHILE | CF_DO | CF_SWITCH | CF_CASE | CF_DEFAULT
							  | CF_RETURN | CF_BREAK | CF_CONTINUE | CF_DISCARD
							  | CONST | precision | type | literal | PARENTHESIS_OPEN
							  | OP_INCREMENT | OP_DECREMENT | OP_NOT | OP_BIT_INVERT | OP_ADD | OP_SUB)

// Struct Declarations
struct_declaration ::= STRUCT struct_name_decl struct_block SEMICOLON
{
	pin=1
}
struct_name_decl ::= IDENTIFIER
{
	implements="com.intellij.psi.PsiNameIdentifierOwner"
	methods=[getName setName getNameIdentifier]
}
struct_block ::= CURLY_BRACKET_OPEN struct_member_list CURLY_BRACKET_CLOSE
{
	pin=1
}
struct_member_list ::= struct_member_item*
{
	recoverWhile=struct_member_list_recover
}
private struct_member_list_recover ::= !(CURLY_BRACKET_CLOSE)
private struct_member_item ::= !(CURLY_BRACKET_CLOSE | <<eof>>) struct_member
{
	pin=1
	recoverWhile=struct_member_recover
}
private struct_member_recover ::= !(CURLY_BRACKET_CLOSE | precision | type)
struct_member ::= precision? type array_size? struct_member_declarator (COMMA struct_member_declarator)* SEMICOLON
{
	pin=2
}
struct_member_declarator ::= struct_member_name_decl array_size?
struct_member_name_decl ::= IDENTIFIER
{
	implements="com.intellij.psi.PsiNameIdentifierOwner"
	methods=[getName setName getNameIdentifier]
}

// Control Statements
control_statement ::= if_statement
					| for_statement
					| while_statement
					| do_while_statement
					| switch_statement
					
if_statement ::= CF_IF PARENTHESIS_OPEN expression PARENTHESIS_CLOSE statement_body else_clause?
{
	pin=1
}

else_clause ::= CF_ELSE (if_statement | statement_body)
{
	pin=1
}

for_statement ::= CF_FOR PARENTHESIS_OPEN for_init? SEMICOLON for_condition? SEMICOLON for_iteration? PARENTHESIS_CLOSE statement_body
{
	pin=1
}
for_init ::= precision? type local_variable_declarator_list
for_condition ::= expression (COMMA expression)*
for_iteration ::= expression (COMMA expression)*

do_while_statement ::= CF_DO statement_body CF_WHILE PARENTHESIS_OPEN expression PARENTHESIS_CLOSE SEMICOLON
{
	pin=1
}

while_statement ::= CF_WHILE PARENTHESIS_OPEN expression PARENTHESIS_CLOSE statement_body
{
	pin=1
}

switch_statement ::= CF_SWITCH PARENTHESIS_OPEN expression PARENTHESIS_CLOSE switch_block
{
	pin=1
}
switch_block ::= CURLY_BRACKET_OPEN switch_body CURLY_BRACKET_CLOSE
{
	pin=1
}
switch_body ::= case_clause*
{
	recoverWhile=switch_body_recover
}
private switch_body_recover ::= !(CURLY_BRACKET_CLOSE)
case_clause ::= CF_CASE expression COLON case_body | CF_DEFAULT COLON case_body
{
	pin=1
}
case_body ::= statement_item*

return_statement ::= CF_RETURN expression? SEMICOLON
{
	pin=1
}

simple_statement ::= (CF_BREAK | CF_CONTINUE | CF_DISCARD) SEMICOLON
{
	pin=1
}

statement_body ::= statement
				 | block
				 
statement ::= control_statement
			| return_statement
			| simple_statement
			| constant_declaration
			| function_call_statement
			| local_variable_declaration
			| expression_statement
			| SEMICOLON

// Expressions
function_call_statement ::= function_call SEMICOLON
// A statement starting with '{' is a block, as in Godot.
expression_statement ::= !CURLY_BRACKET_OPEN expression SEMICOLON
{
	pin=2
}
expression ::= assign_expr

assign_expr ::= conditional_expr (assignment_operator conditional_expr)*
conditional_expr ::= logic_or_expr (QUESTION expression COLON expression)?
logic_or_expr ::= logic_and_expr (OP_OR logic_and_expr)*
logic_and_expr ::= bitwise_or_expr (OP_AND bitwise_or_expr)*
bitwise_or_expr ::= bitwise_xor_expr (OP_BIT_OR bitwise_xor_expr)*
bitwise_xor_expr ::= bitwise_and_expr (OP_BIT_XOR bitwise_and_expr)*
bitwise_and_expr ::= equality_expr (OP_BIT_AND equality_expr)*
equality_expr ::= relational_expr ((OP_EQUAL | OP_NOT_EQUAL) relational_expr)*
relational_expr ::= shift_expr ((OP_LESS | OP_LESS_EQUAL | OP_GREATER | OP_GREATER_EQUAL) shift_expr)*
shift_expr ::= additive_expr ((OP_SHIFT_LEFT | OP_SHIFT_RIGHT) additive_expr)*
additive_expr ::= multiplicative_expr ((OP_ADD | OP_SUB) multiplicative_expr)*
multiplicative_expr ::= unary_expr ((OP_MUL | OP_DIV | OP_MOD) unary_expr)*
unary_expr ::= (OP_NOT | OP_BIT_INVERT | OP_ADD | OP_SUB) unary_expr | (OP_INCREMENT | OP_DECREMENT)? postfix_expr
postfix_expr ::= primary (PERIOD function_call | PERIOD struct_member_name_ref | BRACKET_OPEN expression BRACKET_CLOSE)* (OP_INCREMENT | OP_DECREMENT)?

primary ::= literal
		  | function_call
		  | variable_name_ref
		  | PARENTHESIS_OPEN expression PARENTHESIS_CLOSE
		  | initializer_list

function_call ::= (function_name_ref | type) array_size? PARENTHESIS_OPEN argument_list PARENTHESIS_CLOSE
{
	pin(".*")="PARENTHESIS_OPEN"
}

argument_list ::= [ initializer (COMMA initializer)* ] { pin(".*")=1 }

variable_name_ref ::= IDENTIFIER
{
	methods=[getReference]
}
function_name_ref ::= IDENTIFIER
{
	methods=[getReference]
}
struct_name_ref ::= IDENTIFIER
{
	methods=[getReference]
}
struct_member_name_ref ::= IDENTIFIER
{
	methods=[getReference]
}

// Keywords
precision ::= PRECISION_LOW | PRECISION_MEDIUM | PRECISION_HIGH

type ::= primitive_type
       | TYPE_SAMPLER2D
       | TYPE_ISAMPLER2D
       | TYPE_USAMPLER2D
       | TYPE_SAMPLER2DARRAY
       | TYPE_ISAMPLER2DARRAY
       | TYPE_USAMPLER2DARRAY
       | TYPE_SAMPLER3D
       | TYPE_ISAMPLER3D
       | TYPE_USAMPLER3D
       | TYPE_SAMPLERCUBE
       | TYPE_SAMPLERCUBEARRAY
       | TYPE_SAMPLEREXT
       | struct_name_ref
       
primitive_type ::= TYPE_VOID
			     | TYPE_BOOL
			     | TYPE_BVEC2
			     | TYPE_BVEC3
			     | TYPE_BVEC4
			     | TYPE_INT
			     | TYPE_IVEC2
			     | TYPE_IVEC3
			     | TYPE_IVEC4
			     | TYPE_UINT
			     | TYPE_UVEC2
			     | TYPE_UVEC3
			     | TYPE_UVEC4
			     | TYPE_FLOAT
			     | TYPE_VEC2
			     | TYPE_VEC3
			     | TYPE_VEC4
			     | TYPE_MAT2
			     | TYPE_MAT3
			     | TYPE_MAT4

literal ::= TRUE
		  | FALSE
		  | FLOAT_CONSTANT
		  | INT_CONSTANT
		  | UINT_CONSTANT
		  
// Operators
assignment_operator ::= OP_ASSIGN | OP_ASSIGN_ADD | OP_ASSIGN_SUB | OP_ASSIGN_MUL | OP_ASSIGN_DIV 
                        | OP_ASSIGN_MOD | OP_ASSIGN_SHIFT_LEFT | OP_ASSIGN_SHIFT_RIGHT | OP_ASSIGN_BIT_AND
                        | OP_ASSIGN_BIT_OR | OP_ASSIGN_BIT_XOR
